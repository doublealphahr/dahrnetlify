<%@ Master language="C#" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta http-equiv="Content-Language" content="en" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>Double Alpha HR Consulting</title>
    <style type="text/css">
        body {
            background-color: #FFFFFF;
            margin: 0;
            font-family: Arial, sans-serif;
        }
        a {
            color: #000000;
            text-decoration: none;
        }
        a:hover {
            color: #996633;
        }

        /* ===== 头部 ===== */
        .header-table {
            width: 99%;
            margin: 0 auto;
            border-collapse: collapse;
        }
        .header-logo-cell {
            width: 96px;
            text-align: center;
            vertical-align: middle;
        }
        .header-title-cell {
            width: 277px;
            vertical-align: middle;
            text-align: left;
        }
        .header-title-brand {
            font-family: "Arial Black", Arial, sans-serif;
            color: #996633;
            font-size: medium;
            display: block;
        }
        .header-title-sub {
            font-size: medium;
            color: #000000;
        }
        .header-nav-cell {
            text-align: center;
            vertical-align: middle;
        }
        .header-nav-cell a {
            font-size: medium;
            margin: 0 10px;
            color: #000000;
        }
        .header-lang-cell {
            width: 119px;
            text-align: right;
            vertical-align: middle;
        }

        /* ===== 底部 ===== */
        .footer-wrapper {
            background-color: #F9F7EC;
            padding: 20px 0;
            margin-top: 30px;
        }
        .footer-table {
            width: 98%;
            margin: 0 auto;
            border-collapse: collapse;
        }
        .footer-table td {
            vertical-align: top;
            padding: 8px;
        }
        .footer-heading {
            font-family: "Noto Serif SC Black", "Times New Roman", serif;
            font-size: medium;
            color: #000000;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin: 0 0 10px 0;
        }
        .footer-links p {
            font-family: Arial, sans-serif;
            font-size: small;
            margin: 6px 0;
        }
        .footer-links a {
            color: #000000;
            font-size: small;
        }
        .footer-links a:hover {
            color: #996633;
        }
        .footer-social p {
            margin: 8px 0;
        }
        .footer-social span {
            font-size: xx-small;
            color: #000000;
            margin-left: 4px;
        }
        .footer-copyright {
            text-align: center;
            font-size: small;
            color: #000000;
            margin-top: 20px;
        }
    </style>
</head>

<body>
<form id="form1" runat="server">

    <!-- ================= 统一头部 ================= -->
    <div style="text-align: center;">
        <table class="header-table" cellpadding="0" cellspacing="0">
            <tr>
                <!-- Logo -->
                <td class="header-logo-cell">
                    <a href="../../index.html">
                        <img alt="logo" src="../../wp-content/uploads/2026/02/738364e224a70315eb5cfc5851364505.jpg" width="80" height="80" />
                    </a>
                </td>
                <!-- 站点名称 -->
                <td class="header-title-cell">
                    <span class="header-title-brand">Double Alpha</span>
					<span lang="zh-cn">
                    <span class="header-title-sub">人力资源咨询</span></span>
                </td>
                <!-- 主导航 -->
                <td class="header-nav-cell">
                    <a href="../../about.html">欢迎</a>
                    <a href="../../employer.html">机构服务</a>
                    <a href="../../job.html">个人服务</a>
                    <a href="../../services.html">人力资源服务</a>
                    <a href="../../cv/index.html">简历上传</a>
                </td>
                <!-- 语言切换 -->
                <td class="header-lang-cell">
                    <a href="../../../index.html">
                        <img style="border: 0;" id="img1" src="../../images/button1E.jpg" height="22" width="80" alt="English" />
                    </a>
                </td>
            </tr>
        </table>
    </div>

    <!-- ================= 页面主体（子页面内容插入处） ================= -->
    <asp:ContentPlaceHolder runat="Server" id="CH1">
		<div data-name="ContentPlaceHolderMain"></div>
    </asp:ContentPlaceHolder>

